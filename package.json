{
  "name": "sweet-modal-vue",
  "version": "3.0.0",
  "description": "SweetModal library for use with Vue.js",
  "devDependencies": {
    "@babel/core": "^7.1.2",
    "@babel/preset-env": "^7.1.0",
    "@babel/runtime": "^7.1.2",
    "babel-loader": "^8.0.0",
    "cross-env": "^1.0.6",
    "css-loader": "^0.14.5",
    "file-loader": "^2.0.0",
    "imports-loader": "^0.6.5",
    "node-sass": "^4.9.0",
    "sass-loader": "^7.1.0",
    "script-loader": "^0.7.2",
    "style-loader": "^0.23.0",
    "svg-inline-loader": "^0.8.0",
    "unindent": "^2.0.0",
    "vue": "^2.5.17",
    "vue-highlightjs": "^1.1.0",
    "vue-loader": "^15.4.0",
    "vue-style-loader": "^1.0.0",
    "vue-template-compiler": "^2.5.17",
    "webpack": "^4.20.2",
    "webpack-cli": "^3.1.2",
    "webpack-dev-middleware": "^3.4.0",
    "webpack-dev-server": "^3.1.9",
    "webpack-merge": "^4.1.0"
  },
  "peerDependencies": {
    "vue": "2.x"
  },
  "scripts": {
    "dev": "webpack-dev-server --config docs/webpack.config.js --inline --hot",
    "build": "npm run build-src && npm run build-docs",
